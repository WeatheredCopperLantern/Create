package com.simibubi.create;

public class CreateBuildInfo {
    public static String VERSION = "{{ version }}";
    public static String GIT_COMMIT = "{{ gitCommit }}";
    public static boolean DEV = {{ dev }};

    public static void runIfDev(Runnable runnable){
    	if(DEV) runnable.run();
    }

    public static void runIfRelease(Runnable runnable){
        if(!DEV) runnable.run();
    }

    public static void runIf(Runnable ifDev, Runnable ifRelease){
        if(DEV) ifDev.run();
        else ifRelease.run();
    }
}
